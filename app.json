{
  "expo": {
    "name": "মুদি দোকান",
    "slug": "mudi-dokan",
    "version": "0.1.0",
    "scheme": "mudidokan",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/images/icon.png",
    "platforms": [
      "android"
    ],
    "android": {
      "package": "com.mudidokan.app",
      "adaptiveIcon": {
        "backgroundColor": "#0F6B4F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/hind-siliguri/400Regular/HindSiliguri_400Regular.ttf",
            "./node_modules/@expo-google-fonts/hind-siliguri/500Medium/HindSiliguri_500Medium.ttf",
            "./node_modules/@expo-google-fonts/hind-siliguri/600SemiBold/HindSiliguri_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/hind-siliguri/700Bold/HindSiliguri_700Bold.ttf"
          ]
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "কথা শুনে হিসাব লিখতে মাইক লাগবে।",
          "speechRecognitionPermission": "কথা শুনে হিসাব লিখতে অনুমতি লাগবে।",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.as"
          ]
        }
      ],
      "expo-audio",
      "expo-asset",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-google-signin/google-signin",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.4.20",
            "extraProguardRules": "# expo-background-task (WorkManager): R8 stripped Room's generated DB constructor → crash at start\n-keep class * extends androidx.room.RoomDatabase { <init>(); }\n-keep class androidx.work.impl.** { *; }\n"
          }
        }
      ],
      "./plugins/withReleaseSigning"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
