rules_version = '2';

// Mudi Dokan sync: shops/{uid}/{table}/{rowId}. Only the shop's Google account (uid) can
// read or write its shop. Rows are never deleted (entries are append-only; corrections are
// new rows), so delete is denied for everyone.
service cloud.firestore {
  match /databases/{database}/documents {
    match /shops/{uid}/{table}/{rowId} {
      function isShop() {
        return request.auth != null && request.auth.uid == uid;
      }
      function knownTable() {
        return table in ['shop', 'devices', 'products', 'customers', 'product_aliases',
          'customer_aliases', 'voice_logs', 'purchases', 'sales', 'ledger', 'expenses',
          'owner_withdrawals', 'day_close'];
      }
      allow read: if isShop();
      allow create, update: if isShop() && knownTable()
        && request.resource.data.id == rowId
        && request.resource.data._at == request.time;
      allow delete: if false;
    }
  }
}
